<!-- Push: slide a cube across the table into a goal region. -->
<mujoco model="push">
  <include file="common.xml"/>
  <worldbody>
    <site name="goal" type="cylinder" pos="0.1 0.1 0.001" size="0.05 0.001" material="goal"/>
    <body name="cube" pos="0 0 0.025">
      <freejoint name="cube"/>
      <geom name="cube" type="box" size="0.025 0.025 0.025" mass="0.1" rgba="0.85 0.2 0.2 1"/>
    </body>
  </worldbody>
</mujoco>
