<!--
  Drawer: pull a drawer out of a fixed cabinet by its vertical handle.
  The cabinet opens toward -x; the drawer joint measures how far it is open.
-->
<mujoco model="drawer">
  <include file="common.xml"/>
  <asset>
    <material name="wood" rgba="0.62 0.45 0.30 1"/>
    <material name="drawer" rgba="0.80 0.66 0.48 1"/>
  </asset>
  <worldbody>
    <body name="cabinet" pos="0.2 0 0">
      <geom name="cab_bottom" type="box" size="0.1 0.1 0.005" pos="0 0 0.005" material="wood"/>
      <geom name="cab_top" type="box" size="0.1 0.1 0.005" pos="0 0 0.125" material="wood"/>
      <geom name="cab_left" type="box" size="0.1 0.005 0.065" pos="0 0.105 0.065" material="wood"/>
      <geom name="cab_right" type="box" size="0.1 0.005 0.065" pos="0 -0.105 0.065" material="wood"/>
      <geom name="cab_back" type="box" size="0.005 0.1 0.065" pos="0.105 0 0.065" material="wood"/>
      <body name="drawer" pos="0 0 0.012">
        <joint name="drawer" type="slide" axis="-1 0 0" range="0 0.18" damping="2" frictionloss="0.3"/>
        <geom name="drawer_bottom" type="box" size="0.095 0.095 0.003" pos="0 0 0.003" material="drawer"
              mass="0.2"/>
        <geom name="drawer_front" type="box" size="0.005 0.098 0.05" pos="-0.1 0 0.05" material="drawer"
              mass="0.1"/>
        <geom name="drawer_back" type="box" size="0.004 0.09 0.03" pos="0.09 0 0.03" material="drawer"
              mass="0.05"/>
        <geom name="standoff_top" type="box" size="0.02 0.006 0.004" pos="-0.12 0 0.075"
              material="gripper" mass="0.01"/>
        <geom name="standoff_bottom" type="box" size="0.02 0.006 0.004" pos="-0.12 0 0.025"
              material="gripper" mass="0.01"/>
        <geom name="handle" type="capsule" size="0.008 0.03" pos="-0.135 0 0.05" material="gripper"
              mass="0.02"/>
        <site name="handle" pos="-0.135 0 0.05" size="0.005" rgba="1 1 0 0"/>
      </body>
    </body>
  </worldbody>
</mujoco>
